
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KREAVO - Peminjaman Alat DKV</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="logo">
            <h2>KREAVO<span>.</span></h2>
            <p>Creative Equipment</p>
        </div>

        <nav>
            <a href="#" class="active" data-page="dashboard">⌂ Dashboard</a>
            <a href="#" data-page="katalog">▦ Katalog Alat</a>
            <a href="#" data-page="peminjaman">▣ Peminjaman</a>
            <a href="#" data-page="riwayat">◷ Riwayat</a>
            <a href="#" data-page="profil">♙ Profil Saya</a>
        </nav>

        <div class="sidebar-bottom">
            <p>Creative starts here!</p>
            <button onclick="logout()">Keluar</button>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="main">

        <header class="topbar">
            <div>
                <h2 id="page-title">Dashboard</h2>
                <p>Selamat datang di KREAVO!</p>
            </div>

            <div class="user">
                <div class="avatar">U</div>
                <span>Pengguna</span>
            </div>
        </header>

        <!-- DASHBOARD -->
        <section id="dashboard" class="page active-page">

            <div class="welcome">
                <div>
                    <h1>Halo, Kreator! 👋</h1>
                    <p>Siap membuat karya kreatif hari ini?</p>
                    <button onclick="showPage('katalog')">
                        Mulai Pinjam →
                    </button>
                </div>
                <div class="welcome-icon">🎨</div>
            </div>

            <h2 class="section-title">Ringkasan Aktivitas</h2>

            <div class="stats">
                <div class="stat-card">
                    <span>📦</span>
                    <p>Total Peminjaman</p>
                    <h2 id="total-pinjam">0</h2>
                </div>

                <div class="stat-card">
                    <span>⏳</span>
                    <p>Menunggu Persetujuan</p>
                    <h2 id="total-menunggu">0</h2>
                </div>

                <div class="stat-card">
                    <span>✓</span>
                    <p>Selesai</p>
                    <h2 id="total-selesai">0</h2>
                </div>
            </div>

            <h2 class="section-title">Alat Populer</h2>

            <div class="equipment-grid" id="popular-items"></div>

        </section>

        <!-- KATALOG -->
        <section id="katalog" class="page">

            <h1>Katalog Alat DKV</h1>
            <p class="description">
                Temukan peralatan yang kamu butuhkan untuk berkarya.
            </p>

            <input
                type="text"
                id="search"
                placeholder="Cari nama alat..."
            >

            <div class="equipment-grid" id="catalog-items"></div>

        </section>

        <!-- PEMINJAMAN -->
        <section id="peminjaman" class="page">

            <h1>Form Peminjaman</h1>
            <p class="description">
                Lengkapi data peminjaman alat yang kamu butuhkan.
            </p>

            <form id="loan-form" class="form-card">

                <label>Nama Peminjam</label>
                <input type="text" id="nama" placeholder="Masukkan nama" required>

                <label>Pilih Alat</label>
                <select id="alat" required>
                    <option value="">Pilih alat DKV</option>
                </select>

                <label>Jumlah Barang</label>
                <input type="number" id="jumlah" min="1" value="1" required>

                <label>Tanggal Peminjaman</label>
                <input type="date" id="tanggal" required>

                <label>Tanggal Pengembalian</label>
                <input type="date" id="pengembalian" required>

                <label>Keperluan</label>
                <textarea id="keperluan" placeholder="Tuliskan keperluan peminjaman..." required></textarea>

                <button type="submit" class="primary-btn">
                    Ajukan Peminjaman
                </button>

            </form>

        </section>

        <!-- RIWAYAT -->
        <section id="riwayat" class="page">

            <h1>Riwayat Peminjaman</h1>
            <p class="description">
                Lihat daftar peminjaman alat yang telah kamu ajukan.
            </p>

            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Nama Alat</th>
                            <th>Jumlah</th>
                            <th>Tanggal</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody id="history-list">
                    </tbody>
                </table>
            </div>

        </section>

        <!-- PROFIL -->
        <section id="profil" class="page">

            <h1>Profil Saya</h1>

            <div class="profile-card">
                <div class="profile-avatar">U</div>
                <h2>Pengguna KREAVO</h2>
                <p>Anggota Peminjaman Alat DKV</p>

                <div class="profile-info">
                    <p><b>Nama:</b> <span id="profile-name">Pengguna</span></p>
                    <p><b>Aplikasi:</b> KREAVO</p>
                    <p><b>Status:</b> Pengguna Aktif</p>
                </div>
            </div>

        </section>

        <footer>
            <p>© 2026 KREAVO. Creative Equipment.</p>
        </footer>

    </main>

    <script src="script.js"></script>

</body>
</html>
